# ===== 智能 Agent 群 · 配置文件 =====
# 支持：通用 OpenAI 兼容格式 / Claude 官方规范 / 本地 Ollama 模型

# 【模型提供方选择】
# 可选值：openai (通用兼容接口，如 DeepSeek/OpenAI/千问/硅基流动) | claude (Anthropic 官方) | ollama (本地模型)
AI_PROVIDER=openai

# ==============================================================================
# 1. 通用 OpenAI 兼容模型配置 (AI_PROVIDER=openai)
# ==============================================================================
# 支持 OpenAI, DeepSeek, 月之暗面, 硅基流动, 通义千问, 本地 LM Studio / vLLM 等
# 填入你的 API Key (如 sk-xxxx)
OPENAI_API_KEY=

# Base URL（根据你使用的服务商填写，注意带 /v1）
# 示例：
#   DeepSeek 官方:  https://api.deepseek.com/v1  (模型填 deepseek-chat 或 deepseek-reasoner)
#   OpenAI 官方:    https://api.openai.com/v1     (模型填 gpt-4o 或 gpt-4o-mini)
#   硅基流动:       https://api.siliconflow.cn/v1 (模型填 deepseek-ai/DeepSeek-V3 等)
#   月之暗面 (Kimi): https://api.moonshot.cn/v1   (模型填 moonshot-v1-8k 等)
#   通义千问兼容:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 LM Studio: http://localhost:1234/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 默认模型名称
OPENAI_MODEL=deepseek-chat

# ==============================================================================
# 2. Claude 官方模型配置 (AI_PROVIDER=claude)
# ==============================================================================
# Anthropic 官方 API Key (sk-ant-api03-xxxx)
ANTHROPIC_API_KEY=

# Anthropic Base URL (一般留空默认官方 https://api.anthropic.com，使用中转代理时可填写)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认 Claude 模型 (推荐: claude-3-7-sonnet-20250219 或 claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ==============================================================================
# 3. Ollama 本地模型配置 (AI_PROVIDER=ollama)
# ==============================================================================
# 本地先运行：ollama serve；再拉取模型：ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_STREAM_IDLE_MS=120000

# ==============================================================================
# 4. Agent 执行能力与工具开关 (全部原生支持 Windows)
# ==============================================================================
# 允许 Agent 执行本地系统操作与代码编写
FILE_TOOLS_ENABLED=true
TERMINAL_ENABLED=true
GUI_ENABLED=true
SCREEN_CAPTURE_ENABLED=true

# ==============================================================================
# 5. 服务与网络设置
# ==============================================================================
PORT=3000
BIND_HOST=127.0.0.1
ADMIN_AUTH=auto
ADMIN_PASSWORD=

# 家庭访问口令（留空=关闭；设置后主应用需要口令才能访问数据接口）
# 单口令，不是账号体系；适合家人和信得过的人共用
FAMILY_ACCESS_PASSWORD=

# 单条消息最多几位成员发言 (1-8)
MAX_AGENTS=3

# 日志编码 auto=中文系统用 GBK，utf8=强制 UTF-8
LOG_ENCODING=auto

# ==============================================================================
# 6. 自主性 L2 / L3（可在后台「自主性 L2/L3」页动态调整，数据库设置优先）
# ==============================================================================
# 主动服务后台巡检间隔（分钟，默认 30；开关在后台页面控制）
PROACTIVE_PATROL_MINUTES=30

# ==============================================================================
# 7. 设置中心默认值（可在主界面「设置中心」修改）
# ==============================================================================
# 新对话默认模式：group / private / workflow / proactive / continuous / creative / analysis / autonomous / cross_platform
DEFAULT_CHAT_MODE=group

# 新对话默认工作目录：workspace / project / 绝对路径
DEFAULT_WORK_DIR=workspace

# 用量成本估算单价（每百万 Token；留 0 则成本显示为 0）
USAGE_INPUT_PRICE=0
USAGE_OUTPUT_PRICE=0
USAGE_CACHED_PRICE=0
USAGE_CURRENCY=CNY
